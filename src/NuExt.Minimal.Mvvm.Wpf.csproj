<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net9.0-windows;net8.0-windows;net471;net462</TargetFrameworks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Description>A lightweight WPF add-on for NuExt.Minimal.Mvvm, providing view resolution, dispatcher-aware UI services, dialogs, documents, window lifecycle management, settings, and deterministic cleanup.</Description>
    <RootNamespace>Minimal.Mvvm.Wpf</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;NETSDK1233</NoWarn>
    <VersionPrefix>0.8.4</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Benchmarks" Key="" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" Key="" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' != 'true'">
    <PackageReference Include="NuExt.Minimal.Mvvm" Version="0.8.0" />
    <PackageReference Include="NuExt.Minimal.Behaviors.Wpf" Version="0.8.0" />
    <PackageReference Include="NuExt.Minimal.Mvvm.SourceGenerator" Version="0.8.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NuExt.Presentation.Wpf" Version="0.8.1" />
    <PackageReference Include="NuExt.System" Version="0.8.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(NuExt_UseLocalProjects)' == 'true'">
    <ProjectReference Include="..\..\NuExt.Minimal.Mvvm\src\NuExt.Minimal.Mvvm.csproj" />
    <ProjectReference Include="..\..\NuExt.Minimal.Behaviors.Wpf\src\NuExt.Minimal.Behaviors.Wpf.csproj" />
    <ProjectReference Include="..\..\NuExt.Minimal.Mvvm.SourceGenerator\src\NuExt.Minimal.Mvvm.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\NuExt.Presentation.Wpf\src\NuExt.Presentation.Wpf.csproj" />
    <ProjectReference Include="..\..\NuExt.System\src\NuExt.System.csproj" />
  </ItemGroup>

</Project>