<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nx="clr-namespace:Minimal.Mvvm.Wpf"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">

    <!-- Gap to the previous button only: the outer gaps around the whole row are owned by
         InputDialogContent.ButtonRowMargin, so the row stays evenly inset on every side. -->
    <DataTemplate x:Key="Templates.InputDialog.Button.Default" d:DataType="{x:Type nx:UICommand}">
        <Button Margin="8,0,0,0" MinHeight="25" MinWidth="50" UseLayoutRounding="True"
                Command="{Binding Command}"
                Content="{Binding Content}"
                IsCancel="{Binding IsCancel}"
                IsDefault="{Binding IsDefault}" />
    </DataTemplate>

    <DataTemplate x:Key="Templates.InputDialog.Button" d:DataType="{x:Type nx:UICommand}">
        <Button Margin="8,0,0,0" MinHeight="25" MinWidth="50" UseLayoutRounding="True"
                Command="{Binding Command}"
                Content="{Binding Content}"
                IsCancel="{Binding IsCancel}"
                IsDefault="{Binding IsDefault}" />
    </DataTemplate>

    <nx:DialogButtonTemplateSelector x:Key="InputDialogButtonTemplateSelector"
                                     DefaultButtonTemplate="{StaticResource Templates.InputDialog.Button.Default}"
                                     ButtonTemplate="{StaticResource Templates.InputDialog.Button}" />
</ResourceDictionary>