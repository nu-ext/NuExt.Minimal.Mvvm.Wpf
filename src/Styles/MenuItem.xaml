<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:nx="http://schemas.nuext.minimal/xaml"
                    xmlns:wpf="clr-namespace:Minimal.Mvvm.Wpf"
                    mc:Ignorable="d">

  <ControlTemplate x:Key="Templates.MenuItem.Separator" TargetType="{x:Type MenuItem}">
    <Separator Style="{DynamicResource {x:Static MenuItem.SeparatorStyleKey}}" />
  </ControlTemplate>

  <!-- Attached behaviors for MenuItem -->
  <DataTemplate x:Key="Behaviors.MenuItem" DataType="{x:Type wpf:MenuItemViewModel}">
    <ItemsControl>
      <nx:EventToCommand EventName="SubmenuOpened"
                         Command="{Binding SubmenuOpenedCommand}"
                         CommandParameter="{Binding CommandParameter}" />
      <nx:EventToCommand EventName="SubmenuClosed"
                         Command="{Binding SubmenuClosedCommand}"
                         CommandParameter="{Binding CommandParameter}" />
      <nx:EventToCommand EventName="Checked"
                         Command="{Binding CheckedCommand}"
                         CommandParameter="{Binding CommandParameter}" />
      <nx:EventToCommand EventName="Unchecked"
                         Command="{Binding UncheckedCommand}"
                         CommandParameter="{Binding CommandParameter}" />
    </ItemsControl>
  </DataTemplate>

  <!-- Menu item style -->
  <Style x:Key="Styles.MenuItem.Default" BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
    <d:Style.DataContext>
      <x:Type Type="wpf:MenuItemViewModel" />
    </d:Style.DataContext>
    <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
    <Setter Property="Command" Value="{Binding Command}" />
    <Setter Property="Header" Value="{Binding Header}" />
    <Setter Property="Icon" Value="{Binding Icon}" />
    <Setter Property="InputGestureText" Value="{Binding InputGestureText}" />
    <Setter Property="IsCheckable" Value="{Binding IsCheckable}" />
    <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
    <Setter Property="StaysOpenOnClick" Value="{Binding StaysOpenOnClick}" />
    <Setter Property="IsSubmenuOpen" Value="{Binding IsSubmenuOpen, Mode=TwoWay}" />
    <Setter Property="ItemsSource" Value="{Binding SubMenuItems}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding}" Value="{x:Null}">
        <Setter Property="Template" Value="{StaticResource Templates.MenuItem.Separator}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Styles.MenuItem.Interactive" BasedOn="{StaticResource Styles.MenuItem.Default}" TargetType="{x:Type MenuItem}">
    <Setter Property="nx:Interaction.BehaviorsTemplate" Value="{StaticResource Behaviors.MenuItem}"/>
    <Style.Triggers>
      <!-- Separator placeholders have no view model, so do not attach event behaviors to them -->
      <DataTrigger Binding="{Binding}" Value="{x:Null}">
        <Setter Property="nx:Interaction.BehaviorsTemplate" Value="{x:Null}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>